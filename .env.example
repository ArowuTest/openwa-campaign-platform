APP_ENV=development
HTTP_PORT=8088
HTTP_ADDR=:8080
LOG_LEVEL=info

POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://campaign:replace-me@postgres:5432/campaign?sslmode=disable
DATABASE_DRIVER=postgres
DATABASE_MAX_OPEN=30
DATABASE_MAX_IDLE=10
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_STARTUP_TIMEOUT=30s
DATABASE_PING_TIMEOUT=5s

REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-with-a-long-random-password

# Base64-encoded 32-byte AES-256 key.
MSISDN_ENCRYPTION_KEY_BASE64=
# Base64-encoded key of at least 32 bytes for deterministic HMAC lookups.
MSISDN_LOOKUP_KEY_BASE64=
# Independent base64-encoded 32-byte AES key for TOTP and identity secrets.
IDENTITY_SECRET_KEY_BASE64=
INBOUND_CONTENT_KEY_BASE64=
# Independent privacy-case evidence key. Prefer the JSON keyring variables in
# production so old encrypted access packages remain readable during rotation.
PRIVACY_EVIDENCE_KEY_BASE64=
PRIVACY_EVIDENCE_KEYS_JSON=
PRIVACY_EVIDENCE_ACTIVE_KEY_VERSION=v1
# Independent versioned AES-256 keyring for encrypted per-session proxy credentials.
# Example shape: {"v1":"<base64-encoded-32-byte-key>"}
SENDER_PROXY_KEYS_JSON=
SENDER_PROXY_ACTIVE_KEY_VERSION=v1
INBOUND_CONTENT_RETENTION_DAYS=90
AUDIENCE_IMPORT_SOURCE_RETENTION_DAYS=30

OPENWA_GATEWAY_URL=http://openwa-gateway:2785
GATEWAY_COMMAND_SECRET=replace-with-a-random-command-signing-secret-at-least-32-characters
GATEWAY_RUNTIME_SECRET=replace-with-a-distinct-strong-runtime-registration-secret
# Bootstrap fallback when no approved GATEWAY.RUNTIME_HEALTH policy is active.
GATEWAY_STALE_AFTER_SECONDS=120
MEDIA_DOWNLOAD_SECRET=replace-with-a-random-media-signing-secret-at-least-32-characters
MEDIA_DOWNLOAD_BASE_URL=http://control-api:8080/api/v1/internal/media
# The retained OpenWA media loader keeps SSRF protection enabled; allow only the
# governed control-plane hostname that serves signed internal media URLs.
SSRF_ALLOWED_HOSTS=control-api

# Bootstrap identity is for first internal administrator provisioning only.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-random-password-of-20-plus-characters
BOOTSTRAP_ADMIN_TOTP_SECRET=replace-with-base32-totp-secret
SECURE_COOKIES=true
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

# Shared only between the control API and the isolated gateway callback publisher.
# Use an independently generated value of at least 32 characters in every deployed environment.
GATEWAY_CALLBACK_SECRET=change-me-to-a-random-secret-at-least-32-characters
GATEWAY_CALLBACK_MAX_SKEW=5m

# Portable object-store selection. Filesystem is suitable for development or a
# dedicated encrypted VPS volume. S3 supports AWS S3 and MinIO-compatible stores.
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_ROOT=/var/lib/campaign-platform/objects
OBJECT_STORE_TEMP_DIR=/var/lib/campaign-platform/tmp
# Required only when OBJECT_STORE_DRIVER=s3.
S3_ENDPOINT=https://s3.example.internal
S3_BUCKET=campaign-platform
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PATH_STYLE=true
# Permit plain HTTP only on a trusted private MinIO network.
S3_ALLOW_INSECURE=false
MAX_IMPORT_FILE_BYTES=536870912
# clamd TCP endpoint on a private Docker/VPS network, for example clamav:3310.
CLAMAV_ADDRESS=clamav:3310
CLAMAV_DIAL_TIMEOUT=5s
CLAMAV_SCAN_TIMEOUT=2m

# Audience validation worker. The production binary must link the pinned
# PostgreSQL database/sql driver before this service is enabled.
POSTGRES_DRIVER=postgres
WORKER_HEALTH_ADDR=:8091
WORKER_ID=audience-worker-01
DB_MAX_OPEN=20
DB_MAX_IDLE=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_PING_TIMEOUT=5s
AUDIENCE_WORKER_CONCURRENCY=2
AUDIENCE_WORKER_CLAIM_BATCH=2
AUDIENCE_WORKER_POLL_INTERVAL=1s
AUDIENCE_WORKER_CLAIM_FAILURE_BACKOFF=1s
AUDIENCE_WORKER_MAX_FAILURE_BACKOFF=30s
AUDIENCE_VALIDATION_LEASE_DURATION=2m
AUDIENCE_MERGE_CONCURRENCY=2
AUDIENCE_MERGE_CLAIM_BATCH=2
AUDIENCE_MERGE_LEASE_DURATION=2m
AUDIENCE_MERGE_POLL_INTERVAL=1s
AUDIENCE_MERGE_FAILURE_BACKOFF=30s
AUDIENCE_MATERIALISATION_BATCH_SIZE=5000
AUDIENCE_MATERIALISATION_CLAIM_BATCH=1
AUDIENCE_MATERIALISATION_LEASE_DURATION=2m
AUDIENCE_MATERIALISATION_POLL_INTERVAL=1s
AUDIENCE_SOURCE_RETENTION_BATCH_SIZE=50
AUDIENCE_SOURCE_RETENTION_LEASE_DURATION=2m
AUDIENCE_SOURCE_RETENTION_POLL_INTERVAL=1m
AUDIENCE_STAGE_BATCH_SIZE=1000
MAX_IMPORT_ROWS=2000000
MAX_IMPORT_ISSUES=1000
DEFAULT_COUNTRY_ISO2=NG
WORKER_SHUTDOWN_TIMEOUT=30s

# Campaign outbox and dispatch worker.
CAMPAIGN_WORKER_ID=campaign-worker-01
CAMPAIGN_DB_MAX_OPEN=40
CAMPAIGN_DB_MAX_IDLE=10
CAMPAIGN_JOB_CONCURRENCY=8
CAMPAIGN_JOB_CLAIM_BATCH=8
CAMPAIGN_JOB_LEASE=2m
CAMPAIGN_JOB_POLL_INTERVAL=500ms
OUTBOX_CONCURRENCY=4
DISPATCH_QUEUE_BACKPRESSURE_LIMIT=100000
DISPATCH_QUEUE_BACKPRESSURE_RETRY=5s
DISPATCH_SHARD_TARGET_SIZE=10000
DISPATCH_SHARD_CLAIM_BATCH=20
DISPATCH_QUEUE_REPAIR_BATCH=1000
DISPATCH_QUEUE_REPAIR_INTERVAL=30s
OUTBOX_CLAIM_BATCH=4
OUTBOX_LEASE=2m
OUTBOX_POLL_INTERVAL=500ms
WORKER_OPERATION_TIMEOUT=10s
SENDER_HEARTBEAT_TTL=90s
GATEWAY_HTTP_TIMEOUT=30s
GATEWAY_MAX_RESPONSE_BYTES=1048576

# Campaign metrics reconciliation worker.
METRICS_WORKER_ID=metrics-worker-01
METRICS_DB_MAX_OPEN=12
METRICS_DB_MAX_IDLE=4
METRICS_WORKER_CONCURRENCY=2
METRICS_WORKER_CLAIM_BATCH=2
METRICS_RECONCILIATION_LEASE=1m
METRICS_WORKER_POLL_INTERVAL=5s
METRICS_MATCH_INTERVAL=1m
METRICS_DRIFT_INTERVAL=10s
METRICS_FAILURE_INTERVAL=1m

# Optional network admission boundary. When ALLOWED_NETWORK_CIDRS is non-empty,
# API requests outside these comma-separated IPv4/IPv6 CIDRs are rejected.
# Forwarding headers are trusted only when the directly connected proxy is in
# TRUSTED_PROXY_CIDRS; otherwise the socket peer address is authoritative.
ALLOWED_NETWORK_CIDRS=
TRUSTED_PROXY_CIDRS=

# Exact inbound opt-out commands, comma-separated. Values are normalised and matched exactly.
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL,END,QUIT,OPTOUT,OPT OUT

# OpenWA gateway identity and signed internal command contract
OPENWA_ENGINE=WHATSAPP_WEB_JS
GATEWAY_POOL_ID=00000000-0000-0000-0000-000000000000
GATEWAY_POOL_VERSION=1
GATEWAY_NODE_ID=00000000-0000-0000-0000-000000000000
GATEWAY_NODE_VERSION=1
GATEWAY_ADAPTER_VERSION=0.13.0+platform.1
GATEWAY_CAPABILITIES=SEND_TEXT,SEND_IMAGE,SEND_VIDEO,SEND_DOCUMENT,DELIVERY_EVENTS,READ_EVENTS,INBOUND_MESSAGES
OPENWA_SESSION_REGISTRY_DIR=/data/openwa-session-registry
OPENWA_SESSION_DATA_DIR=/app/session-data
OPENWA_MAX_CONCURRENT_SESSIONS=0
OPENWA_RECONNECT_BASE_DELAY_MS=5000
# Leave OPENWA_RECONNECT_MAX_ATTEMPTS unset for unlimited capped-backoff retries; 0 disables automatic reconnect; 1-20 bounds attempts.
# OPENWA_RECONNECT_MAX_ATTEMPTS=20
OPENWA_RECONNECT_STABILITY_RESET_MS=300000
# Active liveness watchdog for silently wedged READY engines. The interval is process-level; probe/confirmation/teardown values are bootstrap fallbacks for governed SENDER.TRANSPORT_RECOVERY policy.
OPENWA_WATCHDOG_INTERVAL_MS=60000
OPENWA_WATCHDOG_PROBE_TIMEOUT_MS=15000
OPENWA_WATCHDOG_FAILURE_THRESHOLD=2
OPENWA_ENGINE_TEARDOWN_TIMEOUT_MS=30000
OPENWA_LID_CACHE_MAX=5000
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/puppeteer-chrome
GATEWAY_COMMAND_SECRET=replace-with-at-least-32-bytes
GATEWAY_COMMAND_REPLAY_WINDOW_SECONDS=300
CONTROL_API_INBOUND_URL=http://control-api:8080/api/v1/internal/gateway/inbound
GATEWAY_SESSION_AUTHORITY_DIR=/data/gateway-session-authority
GATEWAY_EVENT_OUTBOX_DIR=/data/gateway-event-outbox
GATEWAY_INBOUND_OUTBOX_DIR=/data/gateway-inbound-outbox

# Cross-domain retention and operational alert automation worker.
PLATFORM_GOVERNANCE_WORKER_ID=platform-governance-worker-01
PLATFORM_GOVERNANCE_DB_MAX_OPEN=12
PLATFORM_GOVERNANCE_DB_MAX_IDLE=4
PLATFORM_RETENTION_BATCH=50
PLATFORM_RETENTION_LEASE=2m
PLATFORM_RETENTION_POLL_INTERVAL=1m
ALERT_EVALUATION_INTERVAL=30s
ALERT_ESCALATION_INTERVAL=30s
ALERT_ESCALATION_BATCH=100
ALERT_ESCALATION_LEASE=1m
PLATFORM_GOVERNANCE_FAILURE_BACKOFF=10s

# Secret-file alternatives (recommended for Docker/Kubernetes secrets).
# Configure either NAME or NAME_FILE, never both. Deployed secret files must be
# absolute, regular, non-empty, and <=1 MiB. Ordinary files must have no group/world
# permission bits; a direct /run/secrets/* file is also accepted when the service
# cannot open it for writing (the read-only Docker secret-mount contract).
# DATABASE_URL_FILE=/run/secrets/database_url
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
# BOOTSTRAP_ADMIN_TOTP_SECRET_FILE=/run/secrets/bootstrap_admin_totp
# MSISDN_ENCRYPTION_KEY_BASE64_FILE=/run/secrets/msisdn_encryption_key
# MSISDN_LOOKUP_KEY_BASE64_FILE=/run/secrets/msisdn_lookup_key
# IDENTITY_SECRET_KEY_BASE64_FILE=/run/secrets/identity_secret_key
# INBOUND_CONTENT_KEY_BASE64_FILE=/run/secrets/inbound_content_key
# INBOUND_CONTENT_KEYS_JSON_FILE=/run/secrets/inbound_content_keyring
# PRIVACY_EVIDENCE_KEY_BASE64_FILE=/run/secrets/privacy_evidence_key
# PRIVACY_EVIDENCE_KEYS_JSON_FILE=/run/secrets/privacy_evidence_keyring
# SENDER_PROXY_KEYS_JSON_FILE=/run/secrets/sender_proxy_keyring
# GATEWAY_CALLBACK_SECRET_FILE=/run/secrets/gateway_callback_secret
# GATEWAY_COMMAND_SECRET_FILE=/run/secrets/gateway_command_secret
# GATEWAY_RUNTIME_SECRET_FILE=/run/secrets/gateway_runtime_secret
# MEDIA_DOWNLOAD_SECRET_FILE=/run/secrets/media_download_secret
