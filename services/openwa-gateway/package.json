{
  "name": "@campaign-platform/openwa-gateway",
  "private": true,
  "version": "0.2.0",
  "description": "Isolated WhatsApp transport gateway. OpenWA source will be imported at the approved upstream commit.",
  "scripts": {
    "start:dev": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "sync:retained": "node scripts/sync-retained-openwa.mjs",
    "prebuild": "node scripts/sync-retained-openwa.mjs",
    "pretypecheck": "node scripts/sync-retained-openwa.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "https-proxy-agent": "7.0.6",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socks-proxy-agent": "8.0.5",
    "undici": "8.11.2",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.3",
    "@types/node": "22.17.0",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.2"
  },
  "overrides": {
    "puppeteer": "25.7.0",
    "multer": "2.4.0",
    "qs": "6.16.0",
    "js-yaml": "4.3.2",
    "fast-uri": "3.1.8",
    "sharp": "0.35.5",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.2"
  }
}
