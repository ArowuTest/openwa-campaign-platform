{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://campaign-platform.internal/contracts/gateway-capabilities.schema.json",
  "title":"Governed Gateway Capability Declaration",
  "type":"object",
  "additionalProperties":false,
  "required":["provider","engine","gatewayPoolId","adapterVersion","nodeId","capabilities"],
  "properties":{
    "provider":{"const":"OPENWA"},
    "engine":{"enum":["WHATSAPP_WEB_JS","BAILEYS"]},
    "gatewayPoolId":{"type":"string","minLength":1,"maxLength":200},
    "adapterVersion":{"type":"string","minLength":1,"maxLength":100},
    "nodeId":{"type":"string","minLength":1,"maxLength":200},
    "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["SEND_TEXT","SEND_IMAGE","SEND_VIDEO","SEND_DOCUMENT","DELIVERY_EVENTS","READ_EVENTS","INBOUND_MESSAGES"]}}
  }
}
