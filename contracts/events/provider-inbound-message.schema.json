{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider-inbound-message.schema.json",
  "title": "ProviderInboundMessageV1",
  "type": "object",
  "required": ["schemaVersion", "eventId", "sessionId", "clientReference", "messageText", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "clientReference": { "type": "string", "minLength": 1, "maxLength": 200 },
    "providerMessageId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "messageText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
